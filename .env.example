# Copy this file to .env and replace the secret before running Docker Compose.
APP_ENV=development
DOCS_ENABLED=true
LOG_LEVEL=INFO

# PostgreSQL connection used by the API, worker, and migrations.
POSTGRES_DB=task_management
POSTGRES_USER=task_user
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+asyncpg://task_user:change-me@db:5432/task_management

# JWT configuration. Use a long random value outside local development.
JWT_SECRET_KEY=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Deadline worker configuration.
WORKER_INTERVAL_SECONDS=300
TIMEZONE=Europe/Kyiv

# Pagination defaults.
PAGE_SIZE_DEFAULT=20
PAGE_SIZE_MAX=100
